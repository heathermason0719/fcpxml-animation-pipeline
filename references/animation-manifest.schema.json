{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterforge.local/schemas/animation-manifest-v3.json",
  "title": "AfterForge work model manifest 3.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "workModelVersion",
    "identity",
    "editRevision",
    "project",
    "brief",
    "cues",
    "artifacts",
    "reviewSets",
    "feedback",
    "decisions",
    "deliveries",
    "requests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "workModelVersion": {
      "const": "2.0.0"
    },
    "sourceVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "episodeId": {
          "type": "string",
          "minLength": 1
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "episodeTitle": {
          "type": "string",
          "minLength": 1
        },
        "versionTitle": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "projectId",
        "episodeId",
        "versionId",
        "episodeTitle",
        "versionTitle"
      ],
      "additionalProperties": false
    },
    "editRevision": {
      "type": "integer",
      "minimum": 0
    },
    "project": {
      "type": "object",
      "properties": {
        "source": {
          "type": [
            "object",
            "null"
          ]
        },
        "preview": {
          "$ref": "#/$defs/dimensions"
        },
        "delivery": {
          "$ref": "#/$defs/dimensions"
        },
        "creativeDirection": {
          "type": "object"
        },
        "renderAdapters": {
          "type": "object"
        }
      },
      "required": [
        "source",
        "preview",
        "delivery"
      ],
      "additionalProperties": true
    },
    "brief": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "narration": {
                "type": "string"
              },
              "visualPlan": {
                "type": "string"
              },
              "sourceRole": {
                "type": "string"
              },
              "timeStart": {
                "$ref": "#/$defs/time"
              },
              "timeEnd": {
                "$ref": "#/$defs/time"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "summary",
        "segments"
      ],
      "additionalProperties": false
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "productionMode": {
            "enum": [
              "animation",
              "source-only"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "ready"
            ]
          },
          "segmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolvedTimeline": {
            "type": "object",
            "properties": {
              "start": {
                "$ref": "#/$defs/time"
              },
              "duration": {
                "$ref": "#/$defs/time"
              },
              "authority": {
                "type": "string"
              }
            },
            "required": [
              "start",
              "duration"
            ],
            "additionalProperties": true
          },
          "renderAdapters": {
            "type": "object"
          },
          "layer": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "productionMode"
        ],
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "still",
              "local-preview",
              "full-preview",
              "cue-preview"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "inputKey": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "cueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "complete": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "probe": {
            "type": "object"
          },
          "missingCueIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "inputKey",
          "range",
          "cueIds",
          "complete"
        ],
        "additionalProperties": true
      }
    },
    "reviewSets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inputKey": {
            "type": "string",
            "minLength": 1
          },
          "artifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "inputKey",
          "artifactIds"
        ],
        "additionalProperties": true
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "status": {
            "enum": [
              "pending",
              "needs-clarification",
              "addressed",
              "accepted"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "acceptedSource": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "id",
          "body",
          "source",
          "target",
          "status"
        ],
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "approve",
              "authorize",
              "approve-and-deliver",
              "accept-import",
              "roundtrip"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "reviewSetId": {
            "type": "string",
            "minLength": 1
          },
          "deliveryId": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "source"
        ],
        "additionalProperties": true
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inputKey": {
            "type": "string",
            "minLength": 1
          },
          "protocolVersion": {
            "const": "2"
          },
          "packagePath": {
            "type": "string",
            "minLength": 1
          },
          "snapshotPath": {
            "type": "string",
            "minLength": 1
          },
          "infoFcpxmlSha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "inputKey",
          "protocolVersion",
          "packagePath",
          "snapshotPath",
          "infoFcpxmlSha256"
        ],
        "additionalProperties": true
      }
    },
    "requests": {
      "type": "object"
    },
    "sourceHashes": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "delivery": {
      "type": "object"
    },
    "workModelInputs": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^-?\\d+(?:/\\d+)?s$"
    },
    "source": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "chat",
            "review"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "channel",
        "text",
        "reference"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/time"
        },
        "duration": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "start",
        "duration"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "cueIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "segmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeStart": {
          "$ref": "#/$defs/time"
        },
        "timeEnd": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "versionId"
      ],
      "additionalProperties": false
    }
  }
}
