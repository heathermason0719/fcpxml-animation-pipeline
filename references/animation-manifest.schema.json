{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterforge.local/schemas/animation-manifest-v2.json",
  "title": "AfterForge animation manifest v2",
  "type": "object",
  "required": ["schemaVersion", "sourceVersion", "project", "cues"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "sourceVersion": { "type": "string", "minLength": 1 },
    "reviews": { "type": "object" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "project": {
      "type": "object",
      "required": ["source", "preview", "delivery"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["width", "height", "frameDuration", "duration"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "frameDuration": { "$ref": "#/$defs/rationalTime" },
            "duration": { "$ref": "#/$defs/rationalTime" }
          }
        },
        "preview": { "$ref": "#/$defs/dimensions" },
        "delivery": { "$ref": "#/$defs/dimensions" },
        "renderAdapters": { "type": "object" }
      }
    },
    "cues": {
      "type": "array",
      "items": { "$ref": "#/$defs/cue" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "reviewComment": {
      "type": "object",
      "required": ["id", "stageId", "revision", "author", "body", "status"],
      "oneOf": [
        { "required": ["impactScopes"], "not": { "required": ["issueType"] } },
        { "required": ["issueType"], "not": { "required": ["impactScopes"] } }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^A(?:11|13)-C[0-9]{4,}$" },
        "stageId": { "enum": ["A11", "A13"] },
        "revision": { "type": "integer", "minimum": 1 },
        "author": { "const": "user" },
        "impactScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["static", "motion"] }
        },
        "issueType": { "enum": ["static", "motion"] },
        "body": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "addressed", "accepted"] },
        "cueId": { "type": "string", "minLength": 1 },
        "frameId": { "type": "string", "minLength": 1 },
        "timeStart": { "$ref": "#/$defs/rationalTime" },
        "timeEnd": { "$ref": "#/$defs/rationalTime" },
        "addressedBy": { "const": "agent" },
        "acceptedBy": { "const": "user" }
      },
      "additionalProperties": false
    },
    "stageEvidence": {
      "type": "object",
      "required": ["stageId", "contractVersion", "semanticVersion", "status"],
      "properties": {
        "stageId": { "pattern": "^[AD][1-9][0-9]*$" },
        "contractVersion": { "type": "string", "minLength": 1 },
        "semanticVersion": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1 },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/reviewComment" } }
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "required": ["stageContractVersion", "stageEvidence"],
      "properties": {
        "stageContractVersion": { "type": "string", "minLength": 1 },
        "roundTripRequired": { "type": "boolean" },
        "activeReviewContext": { "type": ["string", "null"], "enum": ["A11", "A13", null] },
        "migration": { "type": "object" },
        "stageEvidence": {
          "type": "object",
          "propertyNames": { "pattern": "^[AD][1-9][0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/stageEvidence" }
        }
      },
      "additionalProperties": false
    },
    "rationalTime": { "type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?s$" },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "deliveryAsset": {
      "type": "object",
      "required": ["fileName", "sha256", "width", "height", "frameRate", "duration", "codec", "hasAlpha"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^AF__[A-Za-z0-9][A-Za-z0-9.-]*\\.mov$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameRate": { "type": "string", "pattern": "^[0-9]+(?:/[1-9][0-9]*)?$" },
        "duration": { "$ref": "#/$defs/rationalTime" },
        "codec": { "const": "prores_4444" },
        "hasAlpha": { "const": true }
      },
      "additionalProperties": false
    },
    "guidanceReview": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["ready", "agent-normalized", "needs-material", "needs-clarification", "out-of-scope", "unaligned"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "layoutLock": {
      "type": ["object", "null"],
      "required": ["revision", "algorithm", "files", "aggregateSha256", "reviewProjection", "projectionSpec", "approvedPoster", "approvedPosterSha256"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "algorithm": { "const": "sha256" },
        "files": { "type": "array" },
        "aggregateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reviewProjection": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^compositions/review/.+\\.html$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "projectionSpec": {
          "type": "object",
          "required": ["mode", "previewWidth", "previewHeight", "deliveryWidth", "deliveryHeight"],
          "properties": {
            "mode": { "const": "delivery-to-preview-axis-scale" },
            "previewWidth": { "type": "integer", "minimum": 1 },
            "previewHeight": { "type": "integer", "minimum": 1 },
            "deliveryWidth": { "type": "integer", "minimum": 1 },
            "deliveryHeight": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "approvedPoster": { "type": "string" },
        "approvedPosterSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reviewFrames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewFrame" }
        },
        "reviewFrameSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "reviewFrame": {
      "type": "object",
      "required": ["id", "role", "label", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "role": { "enum": ["hero", "auxiliary"] },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^approvals/a11/.+" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "animatedAdapter": {
      "type": "object",
      "required": ["compositionId", "compositionSrc", "motionSrc", "reviewSrc", "stillSrc", "heroTime", "layoutDependencies", "layoutLock"],
      "properties": {
        "compositionId": { "type": "string", "minLength": 1 },
        "compositionSrc": { "type": "string", "pattern": "^compositions/cues/.+\\.html$" },
        "motionSrc": { "type": "string", "pattern": "^compositions/motion/.+\\.js$" },
        "reviewSrc": { "type": "string", "pattern": "^compositions/review/.+\\.html$" },
        "stillSrc": { "type": "string", "minLength": 1 },
        "heroTime": { "type": "number", "minimum": 0 },
        "layoutDependencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "layoutRevision": { "type": "integer", "minimum": 0 },
        "layoutLock": { "$ref": "#/$defs/layoutLock" }
      },
      "additionalProperties": false
    },
    "sourceOnlyAdapter": {
      "type": "object",
      "required": ["reviewSrc", "stillSrc", "heroTime"],
      "properties": {
        "reviewSrc": { "type": "string", "pattern": "^compositions/review/.+\\.html$" },
        "stillSrc": { "type": "string", "minLength": 1 },
        "heroTime": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "required": ["id", "productionMode", "workflowState", "resolvedTimeline", "renderAdapters"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "productionMode": { "enum": ["animation", "source-only"] },
        "workflowState": { "enum": ["design-draft", "layout-built", "layout-approved", "motion-built", "motion-approved", "rendered"] },
        "finalAnimationDescription": { "type": "string", "minLength": 1 },
        "guidanceReview": { "$ref": "#/$defs/guidanceReview" },
        "deliveryAsset": { "$ref": "#/$defs/deliveryAsset" },
        "resolvedTimeline": {
          "type": "object",
          "required": ["start", "duration", "authority"],
          "properties": {
            "start": { "$ref": "#/$defs/rationalTime" },
            "duration": { "$ref": "#/$defs/rationalTime" },
            "authority": { "const": "fcpxml" }
          }
        },
        "renderAdapters": {
          "type": "object",
          "required": ["hyperframes"],
          "properties": { "hyperframes": { "type": "object" } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "productionMode": { "const": "animation" } } },
          "then": { "properties": { "renderAdapters": { "properties": { "hyperframes": { "$ref": "#/$defs/animatedAdapter" } } } } },
          "else": {
            "properties": { "renderAdapters": { "properties": { "hyperframes": { "$ref": "#/$defs/sourceOnlyAdapter" } } } },
            "not": { "required": ["deliveryAsset"] }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
