{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterforge.local/schemas/animation-manifest-v3.json",
  "title": "AfterForge work model manifest 3.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "workModelVersion",
    "identity",
    "editRevision",
    "project",
    "brief",
    "cues",
    "artifacts",
    "reviewSets",
    "feedback",
    "decisions",
    "deliveries",
    "requests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "workModelVersion": {
      "enum": [
        "2.0.0",
        "2.1.0"
      ]
    },
    "sourceVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "episodeId": {
          "type": "string",
          "minLength": 1
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "episodeTitle": {
          "type": "string",
          "minLength": 1
        },
        "versionTitle": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "projectId",
        "episodeId",
        "versionId",
        "episodeTitle",
        "versionTitle"
      ],
      "additionalProperties": false
    },
    "editRevision": {
      "type": "integer",
      "minimum": 0
    },
    "project": {
      "type": "object",
      "properties": {
        "source": {
          "type": [
            "object",
            "null"
          ]
        },
        "preview": {
          "$ref": "#/$defs/dimensions"
        },
        "delivery": {
          "$ref": "#/$defs/dimensions"
        },
        "creativeDirection": {
          "type": "object"
        },
        "renderAdapters": {
          "type": "object"
        }
      },
      "required": [
        "source",
        "preview",
        "delivery"
      ],
      "additionalProperties": true
    },
    "brief": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "narration": {
                "type": "string"
              },
              "visualPlan": {
                "type": "string"
              },
              "sourceRole": {
                "type": "string"
              },
              "timeStart": {
                "$ref": "#/$defs/time"
              },
              "timeEnd": {
                "$ref": "#/$defs/time"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "summary",
        "segments"
      ],
      "additionalProperties": false
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "still",
              "local-preview",
              "full-preview",
              "cue-preview",
              "storyboard-frame",
              "exploration-frame"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "inputKey": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "cueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "complete": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "probe": {
            "type": "object"
          },
          "missingCueIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "productionBasis": {
            "$ref": "#/$defs/productionBasis"
          },
          "coverage": {
            "$ref": "#/$defs/coverage"
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "excludedCueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "purpose": {
            "enum": [
              "storyboard",
              "exploration",
              "still"
            ]
          },
          "cueId": {
            "type": "string",
            "minLength": 1
          },
          "frameId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "hero",
              "auxiliary"
            ]
          },
          "mode": {
            "enum": [
              "layout",
              "motion"
            ]
          },
          "background": {
            "enum": [
              "none",
              "timeline"
            ]
          },
          "objectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "previewRequest": {
            "type": "object"
          },
          "variantRevision": {
            "type": "integer",
            "minimum": 1
          },
          "variantContentIdentity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "inputKey",
          "range",
          "cueIds",
          "complete"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "storyboard-frame",
                    "exploration-frame"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "purpose",
                "cueId",
                "frameId",
                "role",
                "mode",
                "background",
                "files",
                "eventId"
              ],
              "properties": {
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        ]
      }
    },
    "reviewSets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inputKey": {
            "type": "string",
            "minLength": 1
          },
          "artifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "createdAt": {
            "type": "string"
          },
          "productionBasis": {
            "$ref": "#/$defs/productionBasis"
          }
        },
        "required": [
          "id",
          "inputKey",
          "artifactIds"
        ],
        "additionalProperties": true
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "status": {
            "enum": [
              "pending",
              "needs-clarification",
              "addressed",
              "accepted"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "acceptedSource": {
            "$ref": "#/$defs/source"
          },
          "applicability": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "current",
                  "deferred",
                  "not-applicable"
                ]
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            },
            "required": [
              "kind",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "body",
          "source",
          "target",
          "status"
        ],
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "approve",
              "authorize",
              "approve-and-deliver",
              "accept-import",
              "roundtrip",
              "confirm-design",
              "explore-motion",
              "authorize-demo",
              "adopt-direction"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "reviewSetId": {
            "type": "string",
            "minLength": 1
          },
          "deliveryId": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string"
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "objectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "storyboardIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "presentationCueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "presentationObjectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "excludedCueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "excludedObjectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "explorationId": {
            "type": "string",
            "minLength": 1
          },
          "variantId": {
            "type": "string",
            "minLength": 1
          },
          "feedbackResolutions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "feedbackId": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "enum": [
                    "accept",
                    "defer",
                    "withdraw"
                  ]
                }
              },
              "required": [
                "feedbackId",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "variantRevision": {
            "type": "integer",
            "minimum": 1
          },
          "variantContentIdentity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "source"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "confirm-design"
                }
              }
            },
            "then": {
              "required": [
                "storyboardIds",
                "objectIds",
                "createdAt"
              ],
              "properties": {
                "objectIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "explore-motion"
                }
              }
            },
            "then": {
              "required": [
                "taskId",
                "cueIds",
                "objectIds",
                "createdAt"
              ],
              "properties": {
                "cueIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "objectIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "authorize-demo"
                }
              }
            },
            "then": {
              "required": [
                "taskId",
                "cueIds",
                "objectIds",
                "presentationCueIds",
                "presentationObjectIds",
                "excludedCueIds",
                "excludedObjectIds",
                "createdAt"
              ],
              "properties": {}
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "adopt-direction"
                }
              }
            },
            "then": {
              "required": [
                "explorationId",
                "variantId",
                "cueIds",
                "createdAt"
              ],
              "properties": {
                "cueIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inputKey": {
            "type": "string",
            "minLength": 1
          },
          "protocolVersion": {
            "const": "2"
          },
          "packagePath": {
            "type": "string",
            "minLength": 1
          },
          "snapshotPath": {
            "type": "string",
            "minLength": 1
          },
          "infoFcpxmlSha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "inputKey",
          "protocolVersion",
          "packagePath",
          "snapshotPath",
          "infoFcpxmlSha256"
        ],
        "additionalProperties": true
      }
    },
    "requests": {
      "type": "object"
    },
    "sourceHashes": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "delivery": {
      "type": "object"
    },
    "workModelInputs": {
      "type": "object"
    },
    "creativeObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/creativeObject"
      }
    },
    "storyboards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storyboard"
      }
    },
    "reviewRounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewRound"
      }
    },
    "productionRuns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productionRun"
      }
    },
    "explorations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exploration"
      }
    },
    "productionCorrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "const": "requested-presentation-missing"
          },
          "missingCueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "createdAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId",
          "jobId",
          "artifactId",
          "reason",
          "missingCueIds",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "required": [
        "version",
        "files",
        "vendorProvenance"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "properties": {
            "package.json": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "hyperframes.json": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "assets/vendor/gsap.min.js": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "package.json",
            "hyperframes.json",
            "assets/vendor/gsap.min.js"
          ],
          "additionalProperties": false
        },
        "vendorProvenance": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "library": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^-?\\d+(?:/\\d+)?s$"
    },
    "source": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "chat",
            "review"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "channel",
        "text",
        "reference"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/time"
        },
        "duration": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "start",
        "duration"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "cueIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "segmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeStart": {
          "$ref": "#/$defs/time"
        },
        "timeEnd": {
          "$ref": "#/$defs/time"
        },
        "storyboardId": {
          "type": "string",
          "minLength": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1
        },
        "explorationId": {
          "type": "string",
          "minLength": 1
        },
        "variantId": {
          "type": "string",
          "minLength": 1
        },
        "objectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "variantRevision": {
          "type": "integer",
          "minimum": 1
        },
        "variantContentIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "versionId"
      ],
      "additionalProperties": false
    },
    "creativeObject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text",
            "reference"
          ],
          "additionalProperties": true
        },
        "continuity": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sourceVersionId": {
              "type": "string",
              "minLength": 1
            },
            "sourceObjectId": {
              "type": "string",
              "minLength": 1
            },
            "sourceManifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "qualificationEvidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "createdAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "sourceVersionId",
            "sourceObjectId",
            "sourceManifestSha256",
            "qualificationEvidenceIds",
            "source",
            "createdAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "storyboard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cueId": {
          "type": "string",
          "minLength": 1
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "narration": {
          "type": "string"
        },
        "finalAnimationDescription": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "contentContext": {
          "$ref": "#/$defs/contentSnapshot"
        }
      },
      "required": [
        "id",
