{
  "contractVersion": "2.2.0",
  "manifestSchemaVersion": "3.0",
  "deliveryProtocolVersion": "3",
  "identityHierarchy": [
    "projectId",
    "episodeId",
    "versionId"
  ],
  "actions": [
    "open",
    "status",
    "update",
    "preview",
    "deliver",
    "resume"
  ],
  "artifactKinds": [
    "still",
    "local-preview",
    "full-preview",
    "cue-preview",
    "storyboard-frame",
    "exploration-frame"
  ],
  "feedbackStates": [
    "pending",
    "needs-clarification",
    "addressed",
    "accepted"
  ],
  "contentStates": [
    "present",
    "none",
    "unknown"
  ],
  "runtimeIdentityClasses": [
    "bootstrap",
    "enroll",
    "repair",
    "change"
  ],
  "feedbackTargetAuthority": "one-resolver-for-confirmation-approval-and-delivery",
  "decisionKinds": [
    "approve",
    "authorize",
    "approve-and-deliver",
    "accept-import",
    "roundtrip",
    "confirm-design",
    "explore-motion",
    "authorize-demo",
    "adopt-direction",
    "confirm-concept"
  ],
  "reviewAuthority": "immutable-review-set-and-current-verified-inputs",
  "legacy": {
    "manifestSchemaVersion": "2.0",
    "stageContractVersion": "1.0.0",
    "defaultAccess": "read-only"
  },
  "reviewRoundStates": [
    "submitted",
    "processing",
    "processed"
  ],
  "creativeAuthority": "product-creative-object-not-technical-cue-id",
  "copyFrom": {
    "requires": "commission plus copyMode=restart or complete objectContinuity",
    "continuation": "historical-qualification-provenance-only; fresh-2.2-requires-concept-confirmation"
  },
  "productionRunAuthority": "commission_fulfilled-only",
  "previewScopes": [
    "storyboard",
    "still",
    "local",
    "full",
    "exploration"
  ],
  "storyboardReview": {
    "pixelContract": 5,
    "reviewIdentity": "reviewInputKey",
    "localNotes": "cue.storyboard.animationNotes",
    "frameNarration": "cue.storyboard.frames[].narration",
    "confirmationScope": "production-inspection-after-concept-confirmation"
  },
  "workingIntent": {
    "operation": "working-intent",
    "storage": "version-manifest",
    "updates": [
      "upserts",
      "removeIds"
    ],
    "authority": "non-authoritative-context-only",
    "inheritsAcrossVersions": false
  },
  "delivery": {
    "directoryPattern": "交付/{episode}-D{number}",
    "xmlPattern": "{episode}-D{number}.fcpxml",
    "mediaScope": "all-reachable-afterforge-animation",
    "mediaPlacement": "regular-sibling-files",
    "duplicatePolicy": "one-inode-per-sha256",
    "evidence": "metadata-and-xml-only",
    "legacyPublication": "read-only"
  },
  "conceptDesign": {
    "operation": "concept",
    "actions": [
      "register",
      "propose",
      "reopen",
      "select"
    ],
    "origins": [
      "codex-generated",
      "user-imported"
    ],
    "formats": [
      "PNG",
      "JPEG",
      "single-frame WebP"
    ],
    "storage": "assets/concepts",
    "confirmation": "confirm-concept with explicit conceptIds and user source",
    "beforeConfirmation": "free-image-exploration; no-code-production",
    "afterConfirmation": "ordinary-production-retains-confirmation; explicit-user-concept-revision-only",
    "legacyWorkModel": "2.1.0 retains Storyboard first-confirmation",
    "selection": "recommendation-only; select with user source atomically revises confirmed concept or reuses historical image",
    "history": "immutable records; copiedFromConceptId preserves source-chain feedback",
    "storyboardHandoff": {
      "operation": "concept-handoff",
      "storage": "storyboardHandoffs",
      "request": "cueIds with aligned exact conceptIds, excludedCueIds, stable requestId, expectedRevision and actual user source",
      "transaction": "confirm pending selected concepts and append selected/excluded object snapshots atomically; all-confirmed still persists scope",
      "status": "conceptDesign.storyboardHandoff latest record with advisory current/problems",
      "authority": "storyboard scope handoff only; no new production gate or Motion/Demo/delivery authorization",
      "execution": "saved by browser; Agent continues from conversation; no automatic wake or rendering"
    }
  },
  "sceneReview": {
    "operation": "scene-review",
    "kinds": [
      "storyboard",
      "animation"
    ],
    "storage": "sceneReviews",
    "targets": "cueId plus storyboardId or artifactId and user source",
    "identity": "storyboard reviewInputKey or verified video artifact with sceneInputKey for the cue interval",
    "status": "sceneReviews current/problems and storyboard.cues[].sceneReview",
    "authority": "non-authoritative-review-progress-only",
    "affectsMediaIdentity": false,
    "requiresForProduction": false
  },
  "creativeInputs": {
    "staging": ".staging/creative-inputs/{round}",
    "candidates": "assets/concepts",
    "allCandidates": "register after generation/import; recommend:false for non-recommended images",
    "referencesAndPrompts": "assets/design-inputs",
    "productionMaterials": "assets/materials",
    "sourceReferences": "original paths are provenance; actual inputs have readable version-owned copies",
    "existingWriters": "previews/cache/jobs/releases unchanged",
    "historicalMaintenance": "explicit scoped authorization; no automatic migration or cleanup"
  }
}
